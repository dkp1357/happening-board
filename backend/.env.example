# happening-board Environment Configuration

# PostgreSQL Configuration (Docker Compose default: db:5432, local dev: localhost:5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=happening_board
# Optional full URI (e.g. from Supabase / Neon / Render):
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Redis Configuration (Docker Compose default: redis:6379, local dev: localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Optional full URI:
# REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=60

# Ingestion Security (Header: 'X-API-Key: <INGEST_API_KEY>')
INGEST_API_KEY=hb_secret_ingest_key_change_me_in_prod

# Scheduling Strategy
# false = Scheduled via external cron (e.g., GitHub Actions workflow)
# true = Runs in-process asyncio background loop
ENABLE_INTERNAL_SCHEDULER=false
AUTO_INGEST_ON_STARTUP=false
MAX_EVENTS_PER_INGEST=50

# Groq Free Tier AI Settings (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BATCH_SIZE=5
AI_ENRICHMENT_ENABLED=true

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Cors
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization